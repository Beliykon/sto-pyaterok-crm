rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allows school staff to view and update shared schedule seamlessly without forcing Google account sign-ins
    match /school_state/{stateId} {
      allow read, write: if true;
    }

    match /appointments/{appointmentId} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow read, write: if true;
    }
  }
}
