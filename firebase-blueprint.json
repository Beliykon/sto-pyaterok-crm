{
  "entities": {
    "SharedCRMState": {
      "title": "SharedCRMState",
      "description": "Shared online database state for appointments, tutors, managers and open slots",
      "type": "object",
      "properties": {
        "appointments": { "type": "array" },
        "openSlots": { "type": "object" },
        "tutors": { "type": "array" },
        "managers": { "type": "array" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" }
      },
      "required": ["updatedAt"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "A scheduled tutoring session.",
      "type": "object",
      "properties": {
        "tutorId": { "type": "string" },
        "studentName": { "type": "string" },
        "date": { "type": "string" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["tutorId", "studentName", "date", "startTime", "endTime", "status"]
    }
  },
  "firestore": {
    "/school_state/{stateId}": {
      "schema": { "$ref": "#/entities/SharedCRMState" },
      "description": "Real-time synchronized school schedule and CRM data"
    },
    "/appointments/{appointmentId}": {
      "schema": { "$ref": "#/entities/Appointment" },
      "description": "Stores scheduled appointments."
    }
  }
}
